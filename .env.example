# Lodariq environment configuration template.
# Real secrets are managed via a single secrets manager (Doppler/Infisical),
# not committed files (PRD §12.1, ADR 0010). Copy to .env for local overrides.

# SDK / local-dev
LODARIQ_WORKSPACE_ID=wk_local_dev
LODARIQ_ENV=development

# --- Phase 1+ control plane (not used by the Phase -1 SDK skeleton) ---
# DATABASE_URL=postgres://...        # Neon PostgreSQL
# LODARIQ_AUTH_MODE=lodariq          # required for deployed API/dashboard; headers are local/test-only
# LODARIQ_EMAIL_DELIVERY_MODE=disabled # fail-closed until provider/secrets/migrations are approved live
# LODARIQ_PUBLIC_SIGNUP_MODE=disabled # enforced by both API and dashboard BFF
# LODARIQ_APP_BASE_URL=https://app.lodariq.com
# LODARIQ_AUTH_EMAIL_FROM=Lodariq <access@lodariq.com>
# LODARIQ_AUTH_EMAIL_TOKEN_SECRET=       # 32+ byte HMAC key; never exposed to browsers
# RESEND_API_KEY=
# LODARIQ_PASSWORD_RECOVERY_MODE=disabled # enforced by both API and dashboard BFF
# LODARIQ_AUTH_BFF_SOURCE_SECRET=      # shared API/dashboard source-envelope key, 32+ bytes
# Owned auth sessions are opaque, hash-stored in PostgreSQL, and require no signing secret.
# LODARIQ_PASSWORD_HASH_MAX_ACTIVE=1       # each Argon2id job uses about 64 MiB
# LODARIQ_PASSWORD_HASH_MAX_QUEUED=8       # bounded backpressure, never an unbounded queue
# LODARIQ_PASSWORD_HASH_QUEUE_TIMEOUT_MS=2000
# LODARIQ_LOADER_SRC=https://cdn.lodariq.com/sdk/lodariq-loader.js
# LODARIQ_CREATOR_LOADER_SRC=https://cdn.lodariq.com/sdk/lodariq-creator.js
# LODARIQ_AUTHORING_IFRAME_SRC=https://editor.lodariq.com/authoring.html
# STRIPE_SECRET_KEY=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# SENTRY_DSN=
