# Lodariq environment configuration
#
# Lodariq has two separate environment layers:
#
#   Execution/deployment layer
#     local       Apps run on localhost with full authentication.
#     development Apps run on the shared Development Fly/R2/Neon stack.
#     staging     Apps run on the existing staging Fly/R2/Neon stack.
#     production  Apps run on the production Fly/R2/Neon stack when approved.
#
#   Workspace release layer
#     development -> staging -> production
#
# Local apps and the hosted Development deployment use the same dedicated Neon
# development project. Local remains the fastest feedback loop; the hosted
# Development stack provides real-origin testing for master and epic branches.
# Every newly created workspace receives exactly one Development, Staging, and
# Production release environment; these are product scopes, not extra servers.
#
# Normal local development is production-parity for authentication:
#   1. Copy the four values in section 1 to .env.development.local.
#   2. Run `pnpm dev:check-env`.
#   3. Run `pnpm dev` and open http://localhost:3000/sign-up.
#
# `pnpm dev` loads only .env.development.local and requires Neon persistence
# plus real Resend delivery. It never exposes verification/reset tokens in the
# UI. Use the explicit `pnpm dev:isolated` command only for disposable offline
# development.
#
# Keep operator values in exactly one ignored file per environment:
#   .env.development.local  local runtime plus development database administration
#   .env.staging.local      staging database administration and verification
#   .env.production.local   production database administration and verification
#
# Never commit these files. Hosted application runtime secrets belong in Fly;
# deployment credentials belong in GitHub Environments. Local files are
# operator inputs, not deployment sources.

# =============================================================================
# 1. LOCAL DEVELOPMENT — the only values you need to supply
# =============================================================================

# Neon development-branch URL using the restricted Lodariq runtime role.
# Do not use neondb_owner/postgres or a production/staging database here.
DATABASE_URL=

# Resend key allowed to send authentication email from the verified address.
RESEND_API_KEY=
LODARIQ_AUTH_EMAIL_FROM=

# Independent 32–256 byte HMAC secret for local verification/reset links.
# Generate once with: openssl rand -base64 48
LODARIQ_AUTH_EMAIL_TOKEN_SECRET=

# Rotation-ready alternative. When present, these replace the legacy value
# above. Retain prior keys for at least 24 hours plus the maximum retry window.
# LODARIQ_AUTH_EMAIL_TOKEN_KEYS={"2026-08":"replace-with-64-random-characters"}
# LODARIQ_AUTH_EMAIL_TOKEN_ACTIVE_KEY_ID=2026-08

# Optional server-only translation provider. Authentication does not need it.
# LODARIQ_DEEPL_API_KEY=

# The local launcher supplies these fixed, non-secret policy values:
#   LODARIQ_AUTH_MODE=lodariq
#   LODARIQ_EMAIL_DELIVERY_MODE=resend
#   LODARIQ_PUBLIC_SIGNUP_MODE=email-verification
#   LODARIQ_PASSWORD_RECOVERY_MODE=email
#   LODARIQ_EXPOSE_DEV_VERIFICATION_TOKEN=false
#   LODARIQ_APP_BASE_URL=http://localhost:3000
#   LODARIQ_API_BASE_URL=http://127.0.0.1:3001
#   LODARIQ_PASSWORD_HASH_MAX_ACTIVE=1
#   LODARIQ_PASSWORD_HASH_MAX_QUEUED=8
#   LODARIQ_PASSWORD_HASH_QUEUE_TIMEOUT_MS=2000

# An owner/admin Neon URL is migration-only. Keep it out of application runtime
# configuration. `pnpm dev` removes NEON_DB_URL before starting child processes
# even if an operator has defined it locally.
# NEON_DB_URL=postgresql://neondb_owner:replace-me@replace-me.neon.tech/neondb?sslmode=require

# =============================================================================
# 2. HOSTED-ENVIRONMENT OPERATOR VALUES — local files, never app runtime
# =============================================================================

# Put these values in .env.staging.local:
# LODARIQ_ENVIRONMENT_PROFILE=staging
# STAGING_NEON_OWNER_DATABASE_URL=postgresql://neondb_owner:replace-me@replace-me.neon.tech/neondb?sslmode=require
# LODARIQ_RUNTIME_DB_ROLE=lodariq_app_staging
# LODARIQ_RUNTIME_DB_PASSWORD=replace-with-an-independent-64-character-secret
# STAGING_RUNTIME_DATABASE_URL=postgresql://lodariq_app_staging:replace-me@replace-me.neon.tech/neondb?sslmode=require
# LODARIQ_AUTH_BFF_SOURCE_SECRET=replace-with-an-independent-64-character-secret
# LODARIQ_AUTH_EMAIL_TOKEN_SECRET=replace-with-an-independent-64-character-secret
# LODARIQ_AUTH_EMAIL_TOKEN_KEYS={"2026-08":"replace-with-an-independent-64-character-secret"}
# LODARIQ_AUTH_EMAIL_TOKEN_ACTIVE_KEY_ID=2026-08
# RESEND_API_KEY=re_replace-me

# Put these values in .env.production.local:
# LODARIQ_ENVIRONMENT_PROFILE=production
# PRODUCTION_NEON_OWNER_DATABASE_URL=postgresql://neondb_owner:replace-me@replace-me.neon.tech/neondb?sslmode=require
# LODARIQ_RUNTIME_DB_ROLE=lodariq_app
# LODARIQ_RUNTIME_DB_PASSWORD=replace-with-an-independent-64-character-secret
# PRODUCTION_RUNTIME_DATABASE_URL=postgresql://lodariq_app:replace-me@replace-me.neon.tech/neondb?sslmode=require

# Owner URLs are used only for reviewed schema and privilege administration.
# Runtime URLs are used for RLS verification and become Fly DATABASE_URL
# secrets. Never give an application the owner URL.

# =============================================================================
# 3. DEPLOYED API + DASHBOARD SECRETS — store in Fly
# =============================================================================

# Use a separate database project/branch and separate secrets for every hosted
# environment. Development may share its Neon project and Resend key with local,
# but its BFF and email-token secrets should be independent from local values.
# DATABASE_URL=postgresql://lodariq_runtime:replace-me@host/database?sslmode=require

# Same environment-specific value on the API and dashboard Fly apps. This signs
# the dashboard-to-API client-source envelope; it never enters browser code.
# LODARIQ_AUTH_BFF_SOURCE_SECRET=

# Required only when deployed auth email is enabled.
# RESEND_API_KEY=
# LODARIQ_AUTH_EMAIL_FROM="Lodariq <access@lodariq.io>"
# LODARIQ_AUTH_EMAIL_TOKEN_SECRET=
# LODARIQ_AUTH_EMAIL_TOKEN_KEYS={"2026-08":"replace-with-an-independent-64-character-secret"}
# LODARIQ_AUTH_EMAIL_TOKEN_ACTIVE_KEY_ID=2026-08

# Optional API-only integration.
# LODARIQ_DEEPL_API_KEY=

# =============================================================================
# 4. DEPLOYED NON-SECRETS — supplied by apps/*/fly*.toml or deployment CI
# =============================================================================

# LODARIQ_AUTH_MODE=lodariq
# LODARIQ_EMAIL_DELIVERY_MODE=disabled
# LODARIQ_PUBLIC_SIGNUP_MODE=disabled
# LODARIQ_PASSWORD_RECOVERY_MODE=disabled
# LODARIQ_APP_BASE_URL=https://app.lodariq.io
# LODARIQ_API_BASE_URL=https://api.lodariq.io
# LODARIQ_PUBLIC_API_BASE_URL=https://api.lodariq.io
# LODARIQ_AUTH_ALLOWED_ORIGINS=https://app.lodariq.io,https://editor.lodariq.io
# LODARIQ_WEBAUTHN_MODE=enabled
# LODARIQ_WEBAUTHN_RP_ID=app.lodariq.io
# LODARIQ_WEBAUTHN_ORIGIN=https://app.lodariq.io
# LODARIQ_OIDC_MODE=disabled
# LODARIQ_OIDC_STATE_SECRET=replace-with-at-least-32-random-bytes
# LODARIQ_GOOGLE_OIDC_CLIENT_ID=
# LODARIQ_GOOGLE_OIDC_CLIENT_SECRET=
# LODARIQ_GOOGLE_OIDC_REDIRECT_URI=https://app.lodariq.io/api/auth/oidc/google/callback
# LODARIQ_MICROSOFT_OIDC_CLIENT_ID=
# LODARIQ_MICROSOFT_OIDC_CLIENT_SECRET=
# LODARIQ_MICROSOFT_OIDC_TENANT=organizations
# LODARIQ_MICROSOFT_OIDC_REDIRECT_URI=https://app.lodariq.io/api/auth/oidc/microsoft/callback
# Enterprise OIDC stays disabled until each connection has passed the external
# Okta/Entra validation runbook. The secret map is API-only and keyed by the
# non-secret sso_ connection ID; client secrets never enter the database.
# LODARIQ_ENTERPRISE_OIDC_MODE=disabled
# LODARIQ_ENTERPRISE_OIDC_REDIRECT_URI=https://app.lodariq.io/api/auth/enterprise/oidc/callback
# LODARIQ_ENTERPRISE_OIDC_CLIENT_SECRETS={"sso_replace_with_connection_id":"replace-with-at-least-32-bytes"}
# LODARIQ_PASSWORD_HASH_MAX_ACTIVE=1
# LODARIQ_PASSWORD_HASH_MAX_QUEUED=8
# LODARIQ_PASSWORD_HASH_QUEUE_TIMEOUT_MS=2000
# LODARIQ_LOADER_SRC=https://cdn.lodariq.io/sdk/lodariq-loader.js
# LODARIQ_PUBLIC_LOADER_SRC=https://cdn.lodariq.io/sdk/lodariq-loader.js
# LODARIQ_CREATOR_LOADER_SRC=https://cdn.lodariq.io/sdk/lodariq-creator.js
# LODARIQ_AUTHORING_IFRAME_SRC=https://editor.lodariq.io/authoring.html

# CI derives this immutable creator-module descriptor from the built asset
# manifest. Do not create or maintain these values manually.
# LODARIQ_CREATOR_MODULE_URL=https://cdn.lodariq.io/sdk/sha256-<digest>/creator.js
# LODARIQ_CREATOR_MODULE_VERSION=sha256-<digest>
# LODARIQ_CREATOR_MODULE_INTEGRITY=sha256-<base64-digest>

# =============================================================================
# 5. GITHUB DEPLOYMENT ENVIRONMENT SECRETS — not application runtime variables
# =============================================================================

# Create three GitHub Environments named exactly:
#   fly-development  automatic master deploys plus manual epic-branch deploys
#   fly-staging      manual master-only release/QA deploys
#   fly-production   manual master-only deploys with typed confirmation
#
# Give fly-development no required reviewers so a master merge can deploy
# automatically. Restrict fly-staging and fly-production according to the
# repository's release approval policy.

# FLY_API_TOKEN=
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_JURISDICTION=default

# CI selects R2_BUCKET/R2_PUBLIC_BASE_URL/R2_JURISDICTION for each target and
# maps the R2 keys to the AWS-compatible variable names used during upload.

# =============================================================================
# 6. NOT ACTIVE YET
# =============================================================================

# Stripe and Sentry do not currently have runtime consumers. Add their variables
# only alongside code that reads and validates them.
