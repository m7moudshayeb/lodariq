{
  "name": "@lodariq/sdk-runtime",
  "version": "0.0.0",
  "private": true,
  "description": "Production Lodariq SDK runtime surface: loader, runtime/player, semantic resolver, and renderers. Framework-free — must never import React or Lexical.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./brand-token-registry": {
      "types": "./dist/brand-token-registry.d.ts",
      "import": "./dist/brand-token-registry.js"
    },
    "./lodariq-loader": {
      "types": "./dist/lodariq-loader.d.ts",
      "import": "./dist/lodariq-loader.js"
    },
    "./public-bootstrap": {
      "types": "./dist/lodariq-public-bootstrap.d.ts",
      "import": "./dist/lodariq-public-bootstrap.js"
    },
    "./activation-client": {
      "types": "./dist/lodariq-activation.d.ts",
      "import": "./dist/lodariq-activation.js"
    },
    "./public-delivery": {
      "types": "./dist/lodariq-public-delivery.d.ts",
      "import": "./dist/lodariq-public-delivery.js"
    },
    "./lodariq-runtime": {
      "types": "./dist/lodariq-runtime.d.ts",
      "import": "./dist/lodariq-runtime.js"
    },
    "./lodariq-local-dev": {
      "types": "./dist/lodariq-local-dev.d.ts",
      "import": "./dist/lodariq-local-dev.js"
    },
    "./loader": {
      "types": "./dist/lodariq-loader.d.ts",
      "import": "./dist/lodariq-loader.js"
    },
    "./activation/public-bootstrap": {
      "types": "./dist/activation/public-bootstrap.d.ts",
      "import": "./dist/activation/public-bootstrap.js"
    },
    "./activation/authoring-activation": {
      "types": "./dist/activation/authoring-activation.d.ts",
      "import": "./dist/activation/authoring-activation.js"
    },
    "./activation/public-delivery": {
      "types": "./dist/activation/public-delivery.d.ts",
      "import": "./dist/activation/public-delivery.js"
    },
    "./runtime": {
      "types": "./dist/runtime/index.d.ts",
      "import": "./dist/runtime/index.js"
    },
    "./resolver": {
      "types": "./dist/resolver/index.d.ts",
      "import": "./dist/resolver/index.js"
    },
    "./renderers/tour": {
      "types": "./dist/renderers/tour.d.ts",
      "import": "./dist/renderers/tour.js"
    },
    "./local-dev": {
      "types": "./dist/local-dev/index.d.ts",
      "import": "./dist/local-dev/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "size": "node ./scripts/check-size.mjs"
  },
  "dependencies": {
    "@floating-ui/dom": "^1.6.13",
    "@lodariq/compiler": "workspace:*",
    "@lodariq/schema": "workspace:*",
    "lucide": "^1.29.0"
  },
  "devDependencies": {
    "tsup": "^8.3.5",
    "typescript": "^5.7.2"
  }
}
