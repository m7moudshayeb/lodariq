{
  "name": "@lodariq/sdk-authoring",
  "version": "0.0.0",
  "private": true,
  "description": "Authenticated-creator-only Lodariq authoring SDK: authoring shell, host-page bridge, and the Lexical-based editor boundary. Loads React and Lexical; never shipped to production viewers.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./lodariq-authoring": {
      "types": "./dist/lodariq-authoring.d.ts",
      "import": "./dist/lodariq-authoring.js"
    },
    "./authoring-frame": {
      "types": "./dist/authoring-frame.d.ts",
      "import": "./dist/authoring-frame.js"
    },
    "./hosted-entry": {
      "types": "./dist/hosted-entry.d.ts",
      "import": "./dist/hosted-entry.js"
    },
    "./bridge": {
      "types": "./dist/bridge/index.d.ts",
      "import": "./dist/bridge/index.js"
    },
    "./editor": {
      "types": "./dist/editor/index.d.ts",
      "import": "./dist/editor/index.js"
    },
    "./creator-toolbar": {
      "types": "./dist/creator-toolbar/index.d.ts",
      "import": "./dist/creator-toolbar/index.js"
    },
    "./creator-install": {
      "types": "./dist/creator-install/index.d.ts",
      "import": "./dist/creator-install/index.js"
    },
    "./creator-experiences": {
      "types": "./dist/creator-experiences.d.ts",
      "import": "./dist/creator-experiences.js"
    },
    "./local-dev": {
      "types": "./dist/local-dev/index.d.ts",
      "import": "./dist/local-dev/index.js"
    },
    "./local-dev/install": {
      "types": "./dist/local-dev/install.d.ts",
      "import": "./dist/local-dev/install.js"
    },
    "./local-dev/frame": {
      "types": "./dist/local-dev/frame.d.ts",
      "import": "./dist/local-dev/frame.js"
    },
    "./local-dev/*": {
      "types": "./dist/local-dev/*.d.ts",
      "import": "./dist/local-dev/*.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "size": "node ./scripts/check-size.mjs"
  },
  "dependencies": {
    "@floating-ui/dom": "^1.6.13",
    "@lexical/rich-text": "^0.21.0",
    "@lodariq/schema": "workspace:*",
    "@lodariq/sdk-runtime": "workspace:*",
    "@radix-ui/react-popover": "^1.1.17",
    "@radix-ui/react-select": "^2.3.1",
    "@radix-ui/react-tabs": "^1.1.15",
    "lexical": "^0.21.0",
    "lucide": "^1.29.0",
    "lucide-react": "^1.22.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2"
  }
}
