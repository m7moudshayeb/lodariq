{
  "name": "@lodariq/tests",
  "version": "0.0.0",
  "private": true,
  "description": "Centralized test suite. Tests mirror the source path of the package under test (packages/tests/<pkg>/src/...) and exercise each package through its public entry points.",
  "type": "module",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint ."
  },
  "devDependencies": {
    "@lodariq/compiler": "workspace:*",
    "@lodariq/schema": "workspace:*",
    "@lodariq/sdk-authoring": "workspace:*",
    "@lodariq/sdk-runtime": "workspace:*",
    "@types/node": "^24.0.0",
    "jsdom": "^25.0.1",
    "typescript": "^5.7.2",
    "vitest": "^4.1.9"
  }
}
