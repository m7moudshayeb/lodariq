{
  "name": "@lodariq/editor",
  "version": "0.0.0",
  "private": true,
  "description": "Hosted Lodariq authoring iframe app served from the dedicated editor origin.",
  "type": "module",
  "scripts": {
    "build": "tsc --noEmit && vite build",
    "build:deploy": "vite build",
    "dev": "vite",
    "lint": "eslint .",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "size": "node ./scripts/check-size.mjs"
  },
  "dependencies": {
    "@lodariq/compiler": "workspace:*",
    "@lodariq/schema": "workspace:*",
    "@lodariq/sdk-authoring": "workspace:*",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "typescript": "^5.7.2",
    "vite": "^6.0.7"
  }
}
