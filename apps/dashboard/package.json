{
  "name": "@lodariq/dashboard",
  "version": "0.0.0",
  "private": true,
  "description": "Next.js 16 dashboard for Lodariq Phase 1 document, environment token, and SDK installation workflows. Deployed on Fly.io.",
  "type": "module",
  "scripts": {
    "build": "pnpm i18n:compile && next build",
    "build:deploy": "pnpm i18n:compile && next build",
    "check:runtime-env": "node ./scripts/check-runtime-env.mjs",
    "dev": "pnpm i18n:compile && next dev --hostname 0.0.0.0 --port 3000",
    "dev:e2e": "pnpm i18n:compile && next dev --hostname 127.0.0.1 --port 3002",
    "i18n:compile": "lingui compile --typescript --workers 1",
    "i18n:extract": "lingui extract --clean --workers 1",
    "i18n:check": "pnpm i18n:extract && git diff --exit-code -- src/locales && pnpm i18n:compile --strict",
    "typecheck": "pnpm i18n:compile && tsc -p tsconfig.json --noEmit",
    "lint": "eslint ."
  },
  "dependencies": {
    "@lingui/core": "^6.6.0",
    "@lingui/react": "^6.6.0",
    "@lodariq/compiler": "workspace:*",
    "@lodariq/i18n": "workspace:*",
    "@lodariq/schema": "workspace:*",
    "@lodariq/sdk-runtime": "workspace:*",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-select": "^2.3.1",
    "@radix-ui/react-slot": "^1.2.4",
    "@simplewebauthn/browser": "13.3.0",
    "@tanstack/react-query": "^5.101.4",
    "@tanstack/react-table": "^8.21.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.22.0",
    "next": "^16.3.0",
    "next-themes": "^0.4.6",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-hook-form": "^7.85.0",
    "server-only": "0.0.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.4.0"
  },
  "devDependencies": {
    "@lingui/cli": "^6.6.0",
    "@lingui/swc-plugin": "^6.6.0",
    "@tailwindcss/postcss": "^4.1.18",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "postcss": "^8.5.25",
    "tailwindcss": "^4.1.18",
    "typescript": "^5.7.2"
  }
}
