{
  "name": "lodariq",
  "version": "0.0.0",
  "private": true,
  "description": "Lodariq — universal product-content platform (interactive demos, tours, onboarding, announcements, surveys, hotspots, knowledge widgets) built on one document-driven authoring model.",
  "type": "module",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=9"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "test": "pnpm run i18n:compile && turbo run test",
    "test:e2e": "pnpm run i18n:compile && playwright test",
    "size": "turbo run size",
    "boundaries": "pnpm run i18n:compile && depcruise --config .dependency-cruiser.cjs packages apps",
    "architecture:check": "node scripts/check-architecture.mjs",
    "i18n:compile": "pnpm --filter @lodariq/dashboard i18n:compile",
    "i18n:check": "pnpm --filter @lodariq/dashboard i18n:check && node scripts/check-localization-catalogs.mjs",
    "knip:check": "pnpm run i18n:compile && knip --dependencies",
    "styles:check": "stylelint \"apps/**/src/**/*.css\" \"packages/sdk-authoring/src/authoring/local-frame-ui/styles/*.ts\"",
    "migrations:check": "pnpm --filter @lodariq/database check:migrations",
    "db:provision:runtime-role": "pnpm --filter @lodariq/database provision:runtime-role",
    "rls:verify:live": "pnpm --filter @lodariq/database verify:live-rls",
    "live:check-env": "pnpm --filter @lodariq/api check:runtime-env && pnpm --filter @lodariq/dashboard check:runtime-env",
    "sdk:prepare-assets": "node scripts/prepare-sdk-assets.mjs",
    "deploy:api": "fly deploy -c apps/api/fly.toml",
    "deploy:api:production": "fly deploy -c apps/api/fly.toml",
    "deploy:api:staging": "fly deploy -c apps/api/fly.staging.toml",
    "deploy:dashboard": "fly deploy -c apps/dashboard/fly.toml",
    "deploy:dashboard:production": "fly deploy -c apps/dashboard/fly.toml",
    "deploy:dashboard:staging": "fly deploy -c apps/dashboard/fly.staging.toml",
    "deploy:editor": "fly deploy -c apps/editor/fly.toml",
    "deploy:editor:production": "fly deploy -c apps/editor/fly.toml",
    "deploy:editor:staging": "fly deploy -c apps/editor/fly.staging.toml",
    "deploy:production": "pnpm deploy:editor:production && pnpm deploy:api:production && pnpm deploy:dashboard:production",
    "deploy:staging": "pnpm deploy:editor:staging && pnpm deploy:api:staging && pnpm deploy:dashboard:staging",
    "audit:security": "pnpm audit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "verify": "pnpm run i18n:check && pnpm run typecheck && pnpm run lint && pnpm run boundaries && pnpm run architecture:check && pnpm run knip:check && pnpm run styles:check && pnpm run migrations:check && pnpm run test && pnpm run build && pnpm run size && pnpm sdk:prepare-assets && pnpm run test:e2e && pnpm run audit:security"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@axe-core/playwright": "^4.11.0",
    "@playwright/test": "^1.61.1",
    "@types/node": "^24.0.0",
    "dependency-cruiser": "^16.8.0",
    "eslint": "^9.17.0",
    "knip": "^6.32.1",
    "postcss-styled-syntax": "^0.7.2",
    "prettier": "^3.4.2",
    "stylelint": "^17.14.1",
    "turbo": "^2.3.3",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.19.0",
    "vitest": "^4.1.9"
  },
  "pnpm": {
    "overrides": {
      "brace-expansion@<1.1.18": "1.1.18",
      "brace-expansion@>=4.0.0 <5.0.9": "5.0.9",
      "bundle-require>esbuild": "0.28.1",
      "fast-uri@>=3.0.0 <3.1.5": "3.1.5",
      "find-my-way@<=9.6.0": "9.7.0",
      "next>postcss": "8.5.25",
      "postcss@<=8.5.22": "8.5.25",
      "tsup>esbuild": "0.28.1"
    }
  }
}
